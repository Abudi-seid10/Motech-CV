# Supabase project credentials — Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
# Current Supabase naming ("publishable key"). VITE_SUPABASE_ANON_KEY (the
# older "anon key" name) is still supported as a fallback if that's what
# your project shows.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# VITE_SUPABASE_ANON_KEY=your-anon-key

# --- AI-powered CV import (Quick start on /edit) — all optional -------------
# Pick whichever provider(s) you want available; the rest can be left blank
# and just won't work as an option. Gemini is the default in the UI.
# IMPORTANT: these are VITE_* variables, which means they are bundled into
# the client-side JavaScript and visible to anyone who opens dev tools — see
# the README's "Resume upload" section before putting a real key here on a
# public deployment.

# Google Gemini — https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key

# OpenAI / ChatGPT — https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your-openai-api-key
VITE_OPENAI_MODEL=gpt-4o-mini

# Ollama — local model server, no API key. Requires OLLAMA_ORIGINS set so
# your browser is allowed to call it (see README).
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2

# OpenRouter — https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your-openrouter-api-key
VITE_OPENROUTER_MODEL=openai/gpt-oss-20b:free
